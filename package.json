{
  "name": "novrpulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CyberNovr newsroom and cybersecurity publication",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm -w backend run dev",
    "dev:frontend": "npm -w frontend run dev",
    "build": "npm -w backend run build && npm -w frontend run build",
    "start": "npm -w backend start",
    "lint": "npm -w backend run lint && npm -w frontend run lint && npm -w @novr/ingest run lint",
    "test": "npm -w @novr/ingest test && npm -w backend test",
    "db:generate": "npm -w backend run db:generate",
    "db:migrate:dev": "npm -w backend run db:migrate:dev",
    "db:migrate": "npm -w backend run db:migrate",
    "db:seed": "npm -w backend run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
