// NovrCampaign — Prisma schema
//
// Thin BFF: Plunk is the source of truth for contacts, campaigns, and
// analytics. This database only stores dashboard access control — the Plunk
// API key is supplied via the environment (internal deployment).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Dashboard auth ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  SENDER
  VIEWER
}
