// NovrCampaign — Prisma schema
//
// Thin BFF: Plunk is the source of truth for contacts, campaigns, and
// analytics. This database only stores dashboard access control — the Plunk
// API key is supplied via the environment (internal deployment).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Dashboard auth ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  oidcSubject  String? @unique
  sessions     StaffSession[]
  accessDecisions StaffAccessRequest[]
  name         String?
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  SENDER
  VIEWER
}

// ── Encrypted file drive ──────────────────────────────────────────────────────
// Deliberately separate from the dashboard `User`/login flow. Password-only,
// one seeded owner, no self-registration. The bucket and these tables hold only
// ciphertext plus wrapped keys; filenames and MIME types are encrypted too.

model DriveUser {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Lockout state for the password-only gate.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  sessions DriveSession[]
  files    DriveFile[]

  @@index([email])
}

model DriveSession {
  id         String   @id @default(uuid())
  userId     String
  user       DriveUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the opaque session token; the raw token lives only in the cookie.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model DriveFile {
  id           String   @id @default(uuid())

  // Ciphertext of the original filename and MIME type, encrypted with the file
  // data key. The plaintext name never touches the database or logs.
  nameCipher   String
  mimeCipher   String

  sizeBytes    BigInt
  chunkCount   Int
  chunkBytes   Int

  ownerId      String
  owner        DriveUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Opaque key under which the assembled encrypted object lives in the bucket.
  storageKey   String   @unique

  // The file data key, wrapped (AES-256-GCM) by the KEK and by the recovery key.
  wrappedKey         String
  wrappedKeyIv       String
  wrappedKeyTag      String
  recoveryWrappedKey String
  recoveryKeyIv      String
  recoveryKeyTag     String

  // Per-file random tenant of the AES-GCM construction (informational).
  createdAt    DateTime @default(now())

  chunks DriveFileChunk[]

  @@index([ownerId])
  @@index([createdAt])
}

// One row per uploaded chunk. `status` tracks an in-flight upload so the
// cleanup job can delete interrupted uploads and their bucket parts.
model DriveFileChunk {
  id         String   @id @default(uuid())
  fileId     String
  file       DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  index      Int
  sizeBytes  Int

  // 'PENDING' while the client is still sending the file, 'COMPLETE' once the
  // final chunk has arrived and the object has been assembled.
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@unique([fileId, index])
  @@index([fileId])
}

// Append-only audit trail. Client IPs are stored HMAC-hashed with a daily-
// rotated server salt; file bytes, tokens, and secrets are never logged.
model DriveAuditLog {
  id        String   @id @default(uuid())
  event     String
  userId    String?
  ipHash    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([userId])
}

// ── NovrPulse event store (Phase 1) ───────────────────────────────────────────
// One store, eight views. Collector output lands here; the understanding layer
// (entities, tagging, summaries, embeddings) and the eight projections read it.
// Mirrors docs/novrpulse/02-event-schema.md, restricted to the Phase 1 subset:
// the entity tables and the pgvector column are deferred until they are used.
//
// Table names are snake_case to match the frozen schema document; models are
// prefixed `Np` to stay unambiguous alongside the NovrCampaign tables.

// Registry mirror of docs/novrpulse/00-source-register.md. The markdown register
// stays the authoritative allowlist; this is the queryable copy.
model NpSource {
  id             String   @id
  name           String
  url            String
  region         String
  functions      Int[]
  type           String
  licence        String   @default("unknown")
  licenceStatus  String   @default("unknown")
  paywall        Boolean  @default(false)
  hasRss         Boolean  @default(false)
  feedUrl        String?
  rateLimit      String?
  reliability    Float?
  approvedBy     String?
  enabled        Boolean  @default(false)
  lastSuccessAt  DateTime?
  canaryOk       Boolean?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documents NpRawDocument[]

  @@map("np_source")
}

// Immutable fetched artefact, content-addressed by hash. A re-fetch that matches
// an existing hash creates nothing. Regulator PDFs are retained long-term.
model NpRawDocument {
  id           String   @id @default(uuid())
  sourceId     String
  source       NpSource @relation(fields: [sourceId], references: [id])
  contentHash  String   @unique
  url          String
  fetchedAt    DateTime @default(now())
  contentType  String?
  storageKey   String?
  httpStatus   Int?
  fetchError   String?
  body         String?

  eventSources NpEventSource[]

  @@index([sourceId, fetchedAt])
  @@map("np_raw_document")
}

// The core object. `functions` is what makes the eight views cheap: one event,
// filtered and rendered eight ways. `summary` is NovrPulse's own words and is
// left empty by collection — the understanding layer writes it.
model NpEvent {
  id            String   @id @default(uuid())
  title         String
  summary       String   @default("")
  whatItMeans   String   @default("")
  publicBriefAttemptedAt DateTime?
  articleVersion        Int       @default(0)
  articleDraft          Json?
  articleEvidence       String?
  articlePublished      Json?
  articleApprovedAt     DateTime?
  articleApprovedBy     String?
  articleRegion         String?
  body          String?
  publishedAt   DateTime?
  canonicalUrl  String?
  language      String   @default("en")
  region        String?
  eventType     String?
  functions     Int[]
  clusterId     String?
  // Reviewer triage state: "new" | "accepted" | "dismissed". Non-destructive —
  // dismiss only records the decision; raw evidence is never touched.
  reviewStatus  String   @default("new")
  // AI filtering classification (owner requirement). Nullable = UNCLASSIFIED:
  // the deterministic keyword pre-tag at store time sets a flag only when it
  // TRUE (leaving null otherwise so the AI pass can still fill it); the batched
  // LLM classification pass then sets all three per its judgment. There is no
  // `aiClassifiedAt` column — the null booleans are the "not yet classified"
  // signal the classification query keys on.
  screeningDecision   String?
  screeningReason     String?
  screeningConfidence Float?
  restoredAt          DateTime?
  restoredBy          String?
  isCybersecurity   Boolean?
  isThreatIntel     Boolean?
  // DEPRECATED: superseded by `cyberRegion` (owner requirement 2026-11-25).
  // The column is RETAINED (additive migrations only; never dropped) but is no
  // longer read or written by classification/filtering. Kept for historical
  // data and so existing rows are never invalidated.
  isNigeriaRelated  Boolean?
  // Regional cybersecurity tier (owner requirement 2026-11-25): 'NG' | 'AF' |
  // 'GLOBAL', NULL = unclassified OR not-cyber. This is the model the owner
  // asked for — is it CYBERSECURITY news, and if so which region, with Nigeria
  // as the priority tier. Set by the deterministic keyword pre-tag at store time
  // (only when the item looks cyber) and authoritatively by the batched AI pass;
  // both leave it NULL when the story is not cyber. A CHECK enforces the domain
  // (see the migration).
  cyberRegion   String?
  createdAt     DateTime @default(now())

  sources NpEventSource[]
  entities NpEventEntity[]
  publishItems PublishItem[]
  publishItemEvents PublishItemEvent[]
  aiJudgements AiJudgement[] @relation("AiJudgementPrimary")

  @@unique([canonicalUrl])
  @@index([publishedAt(sort: Desc)])
  @@index([clusterId])
  @@map("np_event")
}

// Provenance. Every claim in an event must trace to a raw document. The
// (extractorModel, promptVersion) pair lets extraction be cached and skipped,
// not just audited.
model NpEventSource {
  eventId        String
  event          NpEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rawDocumentId  String
  rawDocument    NpRawDocument @relation(fields: [rawDocumentId], references: [id])
  extractorModel String?
  promptVersion  String?
  pageRef        String?
  confidence     String   @default("reported")
  extractedAt    DateTime @default(now())

  @@id([eventId, rawDocumentId])
  @@index([rawDocumentId])
  @@map("np_event_source")
}

// Entity store (plan §3.2, "the moat"). Curated, not model-only: the model
// proposes, a human approves aliases. `merged_into` is the merge path so
// historical events survive a merge without corruption.
model NpEntity {
  id            String   @id @default(uuid())
  type          String
  canonicalName String
  country       String?
  identifiers   Json?
  description   String?
  mergedInto    String?
  createdAt     DateTime @default(now())

  aliases      NpEntityAlias[]
  eventLinks   NpEventEntity[]

  @@index([type])
  @@index([canonicalName])
  @@map("np_entity")
}

// Alias resolution with approval. "GTBank" / "Guaranty Trust" / "GTCO" resolve
// to one entity; the model proposes, this table records the approved mapping.
model NpEntityAlias {
  alias      String   @id
  entityId   String
  entity     NpEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  approvedBy String?
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@map("np_entity_alias")
}

// Which entities an event mentions, and in what role.
model NpEventEntity {
  eventId  String
  event    NpEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entityId String
  entity   NpEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  role     String   @default("mentioned")

  @@id([eventId, entityId, role])
  @@index([entityId])
  @@map("np_event_entity")
}

// The published artefact, kept separate from the event on purpose so a post can
// be corrected without mutating the record it came from (02-event-schema.md §2).
// `tier`/`contentType`/`function_id` are enum-like and stay plain `String`/`Int`
// to match the existing Np* style. Table names follow the frozen document
// literally (`publish_item`/`correction`, no `np_` prefix) — the schema doc is
// the contract.
//
// Owner decision 2026-11-19 (Option C): `publish_item` is the SINGLE editorial
// table. `contentType` is a minimal closed set ('briefing'|'urgent_alert');
// `eventId`/`functionId` are nullable so a non-event-bound briefing can exist;
// the retired `analyst`/`client` tiers are gone (tier is 'public'|'paid').
model PublishItem {
  id              String   @id @default(uuid())
  eventId         String?
  event           NpEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functionId      Int?
  tier            String
  contentType     String
  body            String
  templateVersion String
  // Per-item pillar-specific fields (owner spec 2026-11-24). Both are nullable
  // and additive; only the APPROVE-time gate below requires them, so an existing
  // item without them is still draftable — it just cannot be approved.
  //   * `regulatoryImpact` — pillar 01: which laws/regulations the item affects
  //     and what that means for the reader's business. Required to approve 01.
  //   * `eventDate` — pillar 05: the event's date/time. Required to approve 05,
  //     and must be at least 7 days ahead (the notice gate).
  regulatoryImpact String?
  eventDate        DateTime?
  // Nullable: a projected row is a DRAFT. `editorId`/`approvedAt` are written
  // only by the human approve/withdraw endpoints, never by automation (§2.7).
  editorId        String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  publishedAt     DateTime?
  withdrawnAt     DateTime?
  // Row lifecycle timestamps (owner spec 2026-11-24). `createdAt` is when the
  // piece was created (drives the minimal Today desk's day filter: a piece is in
  // "today's email" when its Lagos day equals today); `updatedAt` is maintained
  // by Prisma on every write. Both are additive and default-filled, so existing
  // rows stay valid.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  corrections  Correction[]
  events       PublishItemEvent[]
  briefing     PublishedBriefing?
  sectionItems BriefingSectionItem[]
  forumTopics  ForumTopic[]
  aiJudgements AiJudgement[]

  @@index([functionId, tier, publishedAt(sort: Desc)])
  @@map("publish_item")
}

// The AI judgement ledger (owner decision 2026-11-23). One row per AI decision
// the layer makes over a subject: a 'dedup' pairing, a 'rewrite', or a
// 'recommend'. The row is the frozen INPUT SNAPSHOT (`scenario`/`detail`) plus
// the model's OUTPUT (`decision`/`confidence`/`rationale`) and the human REVIEW
// outcome. It is append-only training data: only the review columns
// (`outcome`/`reason`/`reviewerId`/`reviewedAt`) may ever change after insert,
// and a row is never deleted (enforced by DB triggers — see the migration).
//
// Exactly one subject must be present: an event (`eventId`), a dedup counterpart
// (`counterpartEventId`), or a publish item (`publishItemId`). `subjectKey` is a
// stable denormalised display/grouping key (e.g. the sorted dedup pair) so a
// review list does not need the counterpart rows to render. Fields kept as plain
// String/Float to match the existing enum-house style.
model AiJudgement {
  id                 String       @id @default(uuid())
  kind               String
  eventId            String?
  event              NpEvent?     @relation("AiJudgementPrimary", fields: [eventId], references: [id], onDelete: SetNull)
  counterpartEventId String?
  publishItemId      String?
  publishItem        PublishItem? @relation(fields: [publishItemId], references: [id], onDelete: SetNull)
  subjectKey         String
  scenario           Json
  decision           String
  confidence         Float?
  rationale          String?
  model              String
  promptVersion      String
  detail             Json?
  outcome            String       @default("pending")
  reason             String?
  reviewerId         String?
  reviewedAt         DateTime?
  createdAt          DateTime     @default(now())

  @@index([kind, outcome, createdAt(sort: Desc)])
  @@index([eventId])
  @@index([subjectKey])
  @@index([publishItemId])
  @@map("ai_judgement")
}

// The ordered linkage of a publish item to the events it covers. A publish item
// has at most one event via the legacy `eventId` FK; this join is the general
// many-to-many form (e.g. a briefing composed from several events). `position`
// preserves the editorial order.
model PublishItemEvent {
  publishItemId String
  publishItem   PublishItem @relation(fields: [publishItemId], references: [id], onDelete: Cascade)
  eventId       String
  event         NpEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position      Int         @default(0)

  @@id([publishItemId, eventId])
  @@index([eventId])
  @@map("publish_item_event")
}

// The immutable snapshot of a published briefing's rendered body. One per
// publish item (owner decision 2026-11-19); `tier`/`contentType` mirror the
// closed sets on `publish_item`.
model PublishedBriefing {
  id              String      @id @default(uuid())
  publishItemId   String      @unique
  publishItem     PublishItem @relation(fields: [publishItemId], references: [id], onDelete: Cascade)
  body            String
  templateVersion String
  tier            String
  contentType     String
  publishedAt     DateTime    @default(now())

  @@map("published_briefing")
}

// First-class corrections: never a silent edit (02-event-schema.md §2).
model Correction {
  id            String      @id @default(uuid())
  publishItemId String
  publishItem   PublishItem @relation(fields: [publishItemId], references: [id], onDelete: Cascade)
  reason        String
  correctedBy   String
  redeliveredAt DateTime?
  at            DateTime

  @@index([publishItemId])
  @@map("correction")
}

// ── Feed (manual cybersecurity updates) ───────────────────────────────────────
// Staff-recorded updates (X posts, news, regulator notices) for the current
// week. Deliberately separate from the NpEvent intel store: that store is under
// review and manual entries must never mix with collector data.
//
// `publishedAt` is what drives which week an entry shows in (a computed filter,
// never stored). `status` is draft|ready|archived. There is no raw body, quote,
// image, tag, or severity field at this phase.

model FeedEntry {
  id          String   @id @default(uuid())
  sourceType  String // 'x' | 'news' | 'regulator' | 'other'
  sourceName  String
  url         String   @unique // normalised (no tracking params, no fragment)
  author      String?
  publishedAt DateTime // staff-editable; drives the week bucket
  title       String
  summary     String // staff-written, required
  status      String   @default("draft") // 'draft' | 'ready' | 'archived'
  createdBy   String // User.id (loose reference; kept additive)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaignLinks CampaignFeedEntry[]

  @@index([publishedAt(sort: Desc)])
  @@index([status])
  @@map("feed_entry")
}

// Which feed entries have been inserted into which campaigns. "Used" is derived
// from these rows — never a stored status. `@@id([campaignId, entryId])` makes
// re-inserting an upsert. campaignId is the Plunk campaign id (not a local FK).
model CampaignFeedEntry {
  campaignId String
  entryId    String
  entry      FeedEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  insertedAt DateTime  @default(now())
  insertedBy String

  @@id([campaignId, entryId])
  @@index([entryId])
  @@map("campaign_feed_entry")
}

// ── Daily briefing desk ───────────────────────────────────────────────────────
// The staff-facing briefing desk: a `briefing` is one day's briefing; it is
// composed from ordered `briefing_section`s (one per function), each of which
// references ordered `briefing_section_item`s (the publish items that make up
// that section). `supporting_event`s and `opportunity`s are standalone desk
// entries; `forum_topic` is a weekly discussion prompt, optionally linked to a
// publish item. `status`/`state`/`kind` are enum-like and stay plain `String` to
// match the existing house style.

model Briefing {
  id           String   @id @default(uuid())
  briefingDate DateTime @unique
  status       String   @default("not_started")
  title        String?
  publishedAt  DateTime?
  sendingAt    DateTime?
  scheduledFor DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sections BriefingSection[]
  publications BriefingPublication[]

  @@index([briefingDate])
  @@map("briefing")
}

// The immutable snapshot of a published BRIEFING's rendered email. Distinct from
// `PublishedBriefing`, which is per-ITEM (one row per `publish_item`): this is
// per-BRIEFING and records the whole rendered HTML plus the segments it was sent
// to (owner requirement 2026-11-25, Publish → Preview → Send). `kind` is
// 'production' | 'test'; a briefing may be published more than once, so
// `(briefingId, version)` is unique. `html` is nullable so a `test` audit row
// does not have to store the whole email.
model BriefingPublication {
  id               String   @id @default(uuid())
  briefingId       String
  briefing         Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  kind             String   @default("production")
  version          Int      @default(1)
  html             String?
  segments         String[]
  recipientSummary Json?
  sentAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  @@unique([briefingId, version])
  @@index([briefingId])
  @@map("briefing_publication")
}

model BriefingSection {
  id         String   @id @default(uuid())
  briefingId String
  briefing   Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  functionId Int
  position   Int
  state      String   @default("empty")
  note       String?

  items BriefingSectionItem[]

  @@unique([briefingId, functionId])
  @@index([briefingId, position])
  @@map("briefing_section")
}

model BriefingSectionItem {
  imageUrl      String?
  imageAlt      String?
  imageCredit   String?
  id            String          @id @default(uuid())
  sectionId     String
  section       BriefingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  publishItemId String
  publishItem   PublishItem     @relation(fields: [publishItemId], references: [id], onDelete: Cascade)
  position      Int

  @@unique([sectionId, publishItemId])
  @@index([sectionId, position])
  @@map("briefing_section_item")
}

model SupportingEvent {
  id              String    @id @default(uuid())
  title           String
  description     String
  organiser       String
  startsAt        DateTime
  venue           String?
  onlineUrl       String?
  registrationUrl String?
  verifiedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([startsAt])
  @@map("supporting_event")
}

model Opportunity {
  id          String    @id @default(uuid())
  title       String
  description String
  kind        String
  provider    String?
  deadline    DateTime?
  url         String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("opportunity")
}

model ForumTopic {
  id            String       @id @default(uuid())
  title         String
  prompt        String
  scheduledFor  DateTime?
  publishItemId String?
  publishItem   PublishItem? @relation(fields: [publishItemId], references: [id], onDelete: SetNull)
  forumUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("forum_topic")
}


model StaffSession {
  hash      String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("staff_session")
}
model NewsletterConfirmation {
  hash String @id
  email String @unique
  expiresAt DateTime
  @@map("newsletter_confirmation")
}

model NewsroomImage {
  hash String @id
  bytes Bytes
  @@map("newsroom_image")
}

enum StaffAccessState {
  NEW
  PENDING
  APPROVED
  DECLINED
}

model StaffAccessRequest {
  id          String @id @default(uuid())
  oidcSubject String @unique
  email       String
  name        String
  status      StaffAccessState @default(NEW)
  requestedAt DateTime?
  decidedAt   DateTime?
  decidedBy   String?
  reviewer    User? @relation(fields: [decidedBy], references: [id], onDelete: SetNull)
  role        Role?
  notices     StaffAccessNotice[]
  @@index([status, requestedAt])
  @@map("staff_access_request")
}

model StaffAccessNotice {
  id          String @id @default(uuid())
  requestId   String
  request     StaffAccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient   String
  kind        String
  attempts    Int @default(0)
  availableAt DateTime @default(now())
  sentAt      DateTime?
  @@unique([requestId, recipient, kind])
  @@index([sentAt, availableAt])
  @@map("staff_access_notice")
}
