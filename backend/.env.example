# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── Database (Supabase Postgres) ────────────────────────
# Only stores dashboard users. Contacts, campaigns, and analytics live in Plunk.
# Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL = Session pooler (port 6543, +?pgbouncer=true) for runtime
#   DIRECT_URL   = Direct connection (port 5432) for migrations
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Dashboard auth (JWT) ────────────────────────────────
# REQUIRED. Must be at least 32 characters, high-entropy, and not a known
# placeholder. In production the app refuses to boot if it is missing, shorter
# than 32 chars, or looks like a placeholder (e.g. the example value below).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Plunk (email provider) ──────────────────────────────
# Secret API key (sk_*) from Plunk → Settings → API Keys.
# Can also be set from the dashboard's Settings page.
PLUNK_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Plunk Cloud base URL; point this at your own domain if self-hosting
PLUNK_BASE_URL=https://next-api.useplunk.com
# Secret expected on /api/webhooks/plunk (x-plunk-webhook-secret)
PLUNK_WEBHOOK_SECRET=replace_with_a_random_string
# Campaigns always send from info@cybernovr.com (hardcoded, verified in Plunk)

# ── CSV importer caps ───────────────────────────────────
# Hobby serverless bodies cap at ~4.5 MB / 10s — on Vercel set:
# CSV_MAX_BYTES=4194304 and CSV_MAX_ROWS=500. Locally the defaults stand.
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=100000

# ── Rate limiting (outbound Plunk call budget) ──────────
PLUNK_RATE_LIMIT_MAX=480
PLUNK_RATE_LIMIT_WINDOW_MS=300000

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug

# ── NovrPulse Daily Briefing send ───────────────────────
# The Plunk segment (id or name) a Daily Briefing is sent to when the publish
# request does not pass `segments` explicitly. When unset, a production publish
# fails closed with NO_SEGMENT_CONFIGURED ("Set NP_PULSE_SEGMENT or pass segments").
NP_PULSE_SEGMENT=

# Vercel cron bearer secret for /api/pulse/collect/run (daily collection).
# When unset, only an ADMIN session may trigger a collection run.
NP_COLLECT_CRON_SECRET=

# ── NovrPulse understanding layer (OpenAI-compatible LLM) ──
# Any OpenAI-compatible endpoint works (NVIDIA NIM, OpenAI, Mistral, OpenRouter,
# or a self-hosted Ollama). Get a NIM key at https://build.nvidia.com (nvapi-...).
# When unset, the understanding layer runs inert (dry runs and tests still work);
# `npm -w backend run understand -- --commit` throws until it is set.
# NP_LLM_API_KEY / NP_LLM_BASE_URL are the current names; NVIDIA_API_KEY /
# NIM_BASE_URL are accepted as legacy fallbacks.
NP_LLM_API_KEY=
NP_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Informational label only (shown in per-call logs); it does NOT change behaviour,
# since every target speaks the same OpenAI-compatible protocol.
NP_LLM_PROVIDER=nvidia-nim
# Legacy aliases (still honoured when the NP_LLM_* names are unset):
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Cheap/fast tier: bulk tagging, entity extraction, classification.
# Verified working on NIM 2026-11-09. Most other slugs returned 410/404 on the
# current key; `nemotron-3.5-lightning` is a reasoning model (output in
# reasoning_content) and is NOT usable for JSON extraction.
NP_BULK_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Frontier tier: summaries and F8 CyberIntel analysis.
NP_FRONTIER_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Optional single fallback: on primary retry exhaustion the client makes ONE
# attempt against this model (same credentials unless a fallback baseUrl/key is
# given). No cascading chain, no circuit breaker.
NP_LLM_FALLBACK_MODEL=
NP_LLM_FALLBACK_BASE_URL=
NP_LLM_FALLBACK_API_KEY=
# Some models ignore `response_format: json_object`. Set NP_LLM_JSON_MODE=false
# to stop sending it. Reading the answer from `reasoning_content` (used by some
# reasoning models, whose `content` is empty) is a SEPARATE explicit opt-in —
# never silent; JSON/schema validation still gates the result.
NP_LLM_JSON_MODE=true
NP_LLM_REASONING_AS_TEXT=false
# Allow a loopback base URL (e.g. a self-hosted Ollama at
# http://localhost:11434/v1). Off by default; loopback is the ONLY case this
# permits — metadata/link-local/private addresses stay blocked.
NP_LLM_ALLOW_LOCAL_BASE_URL=false
NP_LLM_MAX_ATTEMPTS=3
NP_LLM_TIMEOUT_MS=60000
NP_LLM_MAX_TOKENS=1024
NP_LLM_TEMPERATURE=0.2

# ── NovrPulse collector client (stateless novr-collection service) ──
# Pulse triggers collection runs over the collector's frozen HMAC v1 API and
# pages the results back into the NovrPulse store. See
# docs/decisions/adr-0001-collector-hmac-auth.md. When unset, the collector
# client is inert and the existing in-app collector is unaffected.
#
# ── Cutover switch ──
# Selects exactly ONE collection path per run (one writer for `np_*`):
#   false (DEFAULT) → in-app collectors, in-process (behaviour before the cutover)
#   true            → pull from the standalone collector over its HMAC v1 API
# Set to true only once the collector is deployed and reachable — with it true,
# a collector that is unreachable or missing credentials makes collect-store.mjs
# FAIL LOUDLY (no silent fallback; a silent fallback would mask the cutover and
# risk a double write).
NP_COLLECTION_ENABLED=false
# Base URL of the running collector service (its own origin; the `/v1` prefix is
# added per endpoint). A loopback URL (localhost/127.0.0.1) is permitted.
NP_COLLECTION_BASE_URL=http://localhost:4100
# HMAC identity: consumer id + rotatable key id, both matching a registered key
# in the collector's NOVR_COLLECTION_KEYS registry.
NP_COLLECTION_CONSUMER_ID=pulse
NP_COLLECTION_KEY_ID=pulse-2026-01
# Shared HMAC secret matching that key's `secretEnv` value. NEVER commit this.
NP_COLLECTION_SECRET=
# HTTP client tuning.
NP_COLLECTION_TIMEOUT_MS=15000
NP_COLLECTION_PAGE_SIZE=100
NP_COLLECTION_MAX_POLLS=60
NP_COLLECTION_POLL_INTERVAL_MS=1000

PUBLIC_SITE_URL=http://localhost:5173
OIDC_ISSUER_URL=https://accounts.zoho.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
OIDC_ALLOWED_EMAIL_DOMAINS=cybernovr.com
PEXELS_API_KEY=
