# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── Database (Supabase Postgres) ────────────────────────
# Only stores dashboard users. Contacts, campaigns, and analytics live in Plunk.
# Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL = Session pooler (port 6543, +?pgbouncer=true) for runtime
#   DIRECT_URL   = Direct connection (port 5432) for migrations
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Dashboard auth (JWT) ────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Plunk (email provider) ──────────────────────────────
# Secret API key (sk_*) from Plunk → Settings → API Keys.
# Can also be set from the dashboard's Settings page.
PLUNK_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Plunk Cloud base URL; point this at your own domain if self-hosting
PLUNK_BASE_URL=https://next-api.useplunk.com
# Secret expected on /api/webhooks/plunk (x-plunk-webhook-secret)
PLUNK_WEBHOOK_SECRET=replace_with_a_random_string
# Campaigns always send from info@cybernovr.com (hardcoded, verified in Plunk)

# ── CSV importer caps ───────────────────────────────────
# Hobby serverless bodies cap at ~4.5 MB / 10s — on Vercel set:
# CSV_MAX_BYTES=4194304 and CSV_MAX_ROWS=500. Locally the defaults stand.
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=100000

# ── Rate limiting (outbound Plunk call budget) ──────────
PLUNK_RATE_LIMIT_MAX=480
PLUNK_RATE_LIMIT_WINDOW_MS=300000

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
