# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── Database (Supabase Postgres) ────────────────────────
# Only stores dashboard users. Contacts, campaigns, and analytics live in Plunk.
# Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL = Session pooler (port 6543, +?pgbouncer=true) for runtime
#   DIRECT_URL   = Direct connection (port 5432) for migrations
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Dashboard auth (JWT) ────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Plunk (email provider) ──────────────────────────────
# Secret API key (sk_*) from Plunk → Settings → API Keys.
# Can also be set from the dashboard's Settings page.
PLUNK_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Plunk Cloud base URL; point this at your own domain if self-hosting
PLUNK_BASE_URL=https://next-api.useplunk.com
# Secret expected on /api/webhooks/plunk (x-plunk-webhook-secret)
PLUNK_WEBHOOK_SECRET=replace_with_a_random_string
# Campaigns always send from info@cybernovr.com (hardcoded, verified in Plunk)

# ── CSV importer caps ───────────────────────────────────
# Hobby serverless bodies cap at ~4.5 MB / 10s — on Vercel set:
# CSV_MAX_BYTES=4194304 and CSV_MAX_ROWS=500. Locally the defaults stand.
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=100000

# ── Rate limiting (outbound Plunk call budget) ──────────
PLUNK_RATE_LIMIT_MAX=480
PLUNK_RATE_LIMIT_WINDOW_MS=300000

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug

# ── Encrypted file drive (drive at /drive) ──────────────
# Password-only private drive. Files are AES-256-GCM encrypted at rest in a
# private Cloudflare R2 bucket; the DB holds ciphertext, an opaque id, sizes,
# and wrapped keys only. See README "File drive" for the full threat model.
#
# Master switch. When false, drive routes return 404 and new sessions are
# refused; existing files stay intact and are readable again when re-enabled.
DRIVE_ENABLED=false

# 32-byte Key Encryption Key, base64. Wraps each file's data key. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit the real value. Losing it is survivable ONLY with the recovery
# key (see scripts/drive-recovery-restore.mjs); losing both loses all files.
DRIVE_KEK=

# Drive-wide recovery key, printed ONCE by scripts/drive-provision.mjs as a
# base58 string. Keep it offline. It also wraps every data key so files can be
# recovered if the KEK is lost.
DRIVE_RECOVERY_KEY=

# Separate secret for signing 60s per-file download tokens (NOT the KEK).
DRIVE_TOKEN_SECRET=

# Vercel cron bearer secret for /api/drive/maintenance.
CRON_SECRET=

# Server-side salt for HMAC-hashing client IPs stored in the audit log.
DRIVE_IP_SALT=

DRIVE_SESSION_HOURS=2
DRIVE_MAX_FAILED_ATTEMPTS=5
DRIVE_LOCKOUT_MINUTES=15
DRIVE_MIN_PASSWORD_LENGTH=16
DRIVE_MAX_FILE_BYTES=524288000
DRIVE_MAX_TOTAL_BYTES=2147483648
DRIVE_CHUNK_BYTES=4194304
DRIVE_AUDIT_RETENTION_DAYS=90
DRIVE_PARTIAL_UPLOAD_HOURS=24

# ── Cloudflare R2 (S3-compatible object storage) ────────
# Cloudflare dashboard → R2 → Create bucket → Manage R2 API Tokens.
# Bucket must be PRIVATE (no public access). Endpoint is account-scoped.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=novrcampaign-drive
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── NovrPulse understanding layer (NVIDIA NIM) ──────────
# NIM exposes an OpenAI-compatible API, so the client uses the OpenAI SDK
# pointed at the NIM base URL. Get a key at https://build.nvidia.com (nvapi-...).
# When unset, the understanding layer runs inert (dry runs and tests still work);
# `npm -w backend run understand -- --commit` throws until it is set.
NVIDIA_API_KEY=
# Optional overrides; sensible defaults are baked in.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Cheap/fast tier: bulk tagging, entity extraction, classification.
# Verified working on NIM 2026-11-09. Most other slugs returned 410/404 on the
# current key; `nemotron-3.5-lightning` is a reasoning model (output in
# reasoning_content) and is NOT usable for JSON extraction.
NP_BULK_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Frontier tier: summaries and F8 CyberIntel analysis.
NP_FRONTIER_MODEL=nvidia/nemotron-3.5-bolt-e4b
NP_LLM_MAX_ATTEMPTS=3
NP_LLM_TIMEOUT_MS=60000
NP_LLM_MAX_TOKENS=1024
NP_LLM_TEMPERATURE=0.2
