{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "lint": "eslint . --ext .js --max-warnings 0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "prisma generate && prisma migrate deploy && node prisma/seed.js",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "seed:templates": "node scripts/seed-templates.mjs",
    "drive:provision": "node scripts/drive-provision.mjs",
    "drive:kek:rotate": "node scripts/drive-kek-rotate.mjs",
    "drive:recovery:restore": "node scripts/drive-recovery-restore.mjs",
    "drive:cleanup": "node scripts/drive-cleanup.mjs",
    "collect": "node scripts/collect.mjs",
    "collect:store": "node scripts/collect-store.mjs",
    "collect:pull": "node scripts/collect-pull.mjs",
    "sources": "node scripts/sources.mjs",
    "understand": "node scripts/understand.mjs",
    "dedup": "node scripts/dedup.mjs",
    "export:judgements": "node scripts/export-judgements.mjs",
    "test": "node --test",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@novr/ingest": "*",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jose": "^6.2.18",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "openai": "^4.104.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prisma": "^6.2.1"
  }
}
