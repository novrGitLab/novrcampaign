{$CADDY_SITE_ADDRESS} {
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000"
  }
  handle /api/* {
    reverse_proxy backend:4000
  }
  handle {
    reverse_proxy frontend:3000
  }
}

http://127.0.0.1 {
  @scheduled path /api/health /api/pulse/collect/* /api/pulse/maintenance/*
  reverse_proxy @scheduled backend:4000
  respond 404
}
