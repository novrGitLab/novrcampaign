# =============================================================================
# NovrCampaign production environment — TEMPLATE (no secrets).
#
#   cp .env.production.example .env    # then fill every <...> value
#
# This single .env feeds docker-compose.yml. It is gitignored; NEVER commit it.
# Variable NAMES match backend/.env.example and novr-collection/.env.example.
# =============================================================================

# ── Site / TLS ────────────────────────────────────────────────────────────────
# Bare-IP first: DOMAIN=<vps-ip> and CADDY_SITE_ADDRESS=:80 (plain HTTP).
# Real domain:   DOMAIN=app.example.com and CADDY_SITE_ADDRESS=app.example.com
#                (Caddy auto-provisions a Let's Encrypt cert).
DOMAIN=<vps-ip-or-domain>
CADDY_SITE_ADDRESS=:80

# ── PostgreSQL (container on this VPS) ────────────────────────────────────────
POSTGRES_USER=novrcampaign
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=novrcampaign
# Runtime + migration URLs point at the `db` service on the internal network.
# DIRECT_URL is required by the Prisma datasource (directUrl) — same target here.
DATABASE_URL=postgresql://novrcampaign:<strong-random-password>@db:5432/novrcampaign
DIRECT_URL=postgresql://novrcampaign:<strong-random-password>@db:5432/novrcampaign

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Public origin of the SPA (CORS allow-list). Use the IP first, then the domain.
FRONTEND_URL=http://<vps-ip-or-domain>
LOG_LEVEL=info

# ── Dashboard auth (JWT) ──────────────────────────────────────────────────────
# REQUIRED, >=32 chars, high-entropy. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=<generate-32-byte-base64>
JWT_EXPIRES_IN=7d

# Seeded admin (prisma/seed.js). CHANGE THE PASSWORD after first login.
SEED_EMAIL=admin@novrcampaign.local
SEED_PASSWORD=<change-me-strong>

# ── Plunk (email provider) ────────────────────────────────────────────────────
PLUNK_API_KEY=<sk_...>
PLUNK_BASE_URL=https://next-api.useplunk.com
PLUNK_WEBHOOK_SECRET=<random-string>
PLUNK_RATE_LIMIT_MAX=480
PLUNK_RATE_LIMIT_WINDOW_MS=300000

# ── CSV importer caps ─────────────────────────────────────────────────────────
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=100000

# ── NovrPulse Daily Briefing ──────────────────────────────────────────────────
# Plunk segment (id or name) a briefing is sent to when none is passed. Unset in
# production → publish fails closed with NO_SEGMENT_CONFIGURED.
NP_PULSE_SEGMENT=

# ── NovrPulse understanding layer (OpenAI-compatible LLM) ─────────────────────
NP_LLM_API_KEY=<nvapi-...>
NP_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NP_LLM_PROVIDER=nvidia-nim
NP_BULK_MODEL=nvidia/nemotron-3.5-bolt-e4b
NP_FRONTIER_MODEL=nvidia/nemotron-3.5-bolt-e4b
NP_LLM_FALLBACK_MODEL=
NP_LLM_FALLBACK_BASE_URL=
NP_LLM_FALLBACK_API_KEY=
NP_LLM_JSON_MODE=true
NP_LLM_REASONING_AS_TEXT=false
NP_LLM_ALLOW_LOCAL_BASE_URL=false
NP_LLM_MAX_ATTEMPTS=3
NP_LLM_TIMEOUT_MS=60000
NP_LLM_MAX_TOKENS=1024
NP_LLM_TEMPERATURE=0.2

# ── NovrPulse collector (standalone novr-collection service) ──────────────────
# Cutover switch: true → pull from the standalone collector over HMAC v1.
# Leave false until the collector is deployed and reachable.
NP_COLLECTION_ENABLED=false
# Internal service DNS (the collector container on the `novr` network).
NP_COLLECTION_BASE_URL=http://collector:4100
NP_COLLECTION_CONSUMER_ID=pulse
NP_COLLECTION_KEY_ID=pulse-2026-01
# Shared HMAC secret. MUST equal the collector's NOVR_COLLECTION_KEY_PULSE_2026_01.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NP_COLLECTION_SECRET=<shared-hmac-secret>
NP_COLLECTION_TIMEOUT_MS=15000
NP_COLLECTION_PAGE_SIZE=100
NP_COLLECTION_MAX_POLLS=60
NP_COLLECTION_POLL_INTERVAL_MS=1000

# Bearer secret for the daily collection cron → POST /api/pulse/collect/run.
NP_COLLECT_CRON_SECRET=<random-string>

# ── Collector service env (used ONLY by the `collector` compose profile) ──────
# Registry maps consumer/keyId to the env var NAME holding its secret.
NOVR_COLLECTION_KEYS=[{"consumerId":"pulse","keyId":"pulse-2026-01","secretEnv":"NOVR_COLLECTION_KEY_PULSE_2026_01","scopes":["runs:read","runs:create"],"enabled":true}]
# Must equal NP_COLLECTION_SECRET above.
NOVR_COLLECTION_KEY_PULSE_2026_01=<shared-hmac-secret>
NOVR_COLLECTION_SKEW_SECONDS=300
NOVR_COLLECTION_NONCE_TTL_MS=600000
NOVR_COLLECTION_RUN_TTL_MS=900000
NOVR_COLLECTION_MAX_LIVE_RUNS=200
NOVR_COLLECTION_MAX_TOTAL_RUNS=500
NOVR_COLLECTION_MAX_TOTAL_FETCHES=16
NOVR_COLLECTION_DEFAULT_CONCURRENCY=3
NOVR_COLLECTION_MAX_CONCURRENCY=8
NOVR_COLLECTION_BODY_LIMIT_BYTES=262144

# ── Encrypted file drive (optional; see backend/.env.example for full detail) ─
DRIVE_ENABLED=false
DRIVE_KEK=
DRIVE_RECOVERY_KEY=
DRIVE_TOKEN_SECRET=
DRIVE_IP_SALT=
CRON_SECRET=
DRIVE_SESSION_HOURS=2
DRIVE_MAX_FAILED_ATTEMPTS=5
DRIVE_LOCKOUT_MINUTES=15
DRIVE_MIN_PASSWORD_LENGTH=16
DRIVE_MAX_FILE_BYTES=524288000
DRIVE_MAX_TOTAL_BYTES=2147483648
DRIVE_CHUNK_BYTES=4194304
DRIVE_AUDIT_RETENTION_DAYS=90
DRIVE_PARTIAL_UPLOAD_HOURS=24

# ── Cloudflare R2 (optional; required only when DRIVE_ENABLED=true) ───────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=novrcampaign-drive
R2_ENDPOINT=
