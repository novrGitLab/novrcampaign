# Root .dockerignore — context is the repository root.
# Keeps the build context small and prevents secrets / host artifacts leaking in.

# VCS + agent/tooling state
.git
.gitignore
.gitattributes
.github
.claude
.kilo
.claudeignore
AGENTS.md
AGENTS.md.bak.*
CLAUDE.md
kilo.json

# Dependencies (installed fresh inside the image)
node_modules
**/node_modules

# Build output
dist
**/dist
drive-dist
build

# Environment / secrets — NEVER in an image
.env
.env.*
!.env.example
backend/.env
backend/.env.*
backend/.env.backup-*
frontend/.env
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# Prisma generated client (regenerated during build)
backend/src/generated

# Logs
logs
*.log
npm-debug.log*

# Tests + coverage
coverage
.nyc_output

# Docs, reference material, scratch
docs
*.pdf
*.docx
*.xlsx
*.csv
judgements-export*.jsonl
tmp-*.mjs

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
*.swp

# Docker volumes
postgres_data
